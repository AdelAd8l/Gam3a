# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GAM3A_SECRET_KEY=

# Seed demo@gam3a.dev and show a "demo account" button on the sign-in page.
GAM3A_DEMO=false

# Set to false after creating your own account to keep a personal server private.
GAM3A_ALLOW_SIGNUP=true

# Set to true when served over HTTPS.
GAM3A_COOKIE_SECURE=false

# Defaults to a local SQLite file. Postgres URLs (e.g. from Neon or Supabase) work as-is.
# GAM3A_DATABASE_URL=postgresql://user:password@host/dbname
