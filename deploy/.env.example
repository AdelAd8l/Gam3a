# Copied to .env by setup.sh, which fills in the secrets for you.

TALLY_DOMAIN=tally-me.duckdns.org
GAM3A_DOMAIN=gam3a.duckdns.org

# Both DuckDNS names, without ".duckdns.org", comma-separated.
DUCKDNS_DOMAINS=tally-me,gam3a
# From https://www.duckdns.org (shown at the top after you sign in).
DUCKDNS_TOKEN=

# Generated by setup.sh. Keep them secret; don't change them after the first start.
POSTGRES_PASSWORD=
TALLY_SECRET_KEY=
GAM3A_SECRET_KEY=

# true only until you've created your accounts (the Neon import brings them along).
ALLOW_SIGNUP=false
