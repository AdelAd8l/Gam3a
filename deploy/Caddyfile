# HTTPS certificates are requested from Let's Encrypt automatically.

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$TALLY_DOMAIN} {
	import common
	reverse_proxy tally:8000
}

{$GAM3A_DOMAIN} {
	import common
	reverse_proxy gam3a:8000
}
